APP_ENV=development
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg2://lta:lta_secret@db:5432/learn_to_teach
PROMPT_VERSION=v1
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_USERNAME=admin
# bcrypt hash for password "changeme" — replace before any real deployment
# Docker Compose treats $ as interpolation, so escape each $ as $$ in .env files used by Compose.
ADMIN_PASSWORD_HASH=$$2b$$12$$zaovZi/O6RspjKcr2O3Fmus84ItPhAfhVNWeYXZtbCLEbVslJLcRi
SESSION_SECRET=change-me-to-a-long-random-string
MAX_UPLOAD_BYTES=1048576
